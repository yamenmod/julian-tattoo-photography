# Copy this file to `.env` and fill in your local secrets. DO NOT commit real credentials.
# Julian Photography contact and booking email destination
JULIAN_EMAIL=juliansabaghtattoos@gmail.com
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=Julian Photography
SMTP_USER=your-sending-gmail@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Render production email option. Use only with a verified Resend sender.
RESEND_API_KEY=

# Backward-compatible aliases for older app code
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-sending-gmail@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password

# PayPal sandbox credentials
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# Server port (optional)
PORT=5000
INIT_DATABASE=true

# Database configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=surf_products
JWT_SECRET=replace-with-a-long-random-secret
